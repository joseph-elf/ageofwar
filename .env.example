# Copy to .env (or set in your host's build environment) BEFORE `npm run build`.
# A TURN relay lets players on mobile data / strict firewalls connect. Only ONE side needs it (usually the phone), but baking it
# into the build means everyone gets it. Note: these values end up in the public JavaScript, so prefer a provider that issues
# limited/rotating credentials.
VITE_TURN_URLS=turn:YOUR_TURN_HOST:3478,turns:YOUR_TURN_HOST:443?transport=tcp
VITE_TURN_USER=your-username
VITE_TURN_PASS=your-password

# Optional: self-hosted PeerJS signaling server (default: PeerJS public cloud)
# VITE_PEER_HOST=
# VITE_PEER_PORT=443
# VITE_PEER_PATH=/
# VITE_PEER_SECURE=true
